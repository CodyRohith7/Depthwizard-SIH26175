# Copy to .env and fill in as needed. Nothing here is required for M0/M1.

# Overrides configs/depth.yaml's default backend ("depth-anything-v2-small").
DEPTHWIZARD_DEPTH_BACKEND=depth-anything-v2-small

# Hugging Face cache dir for downloaded model weights (optional).
HF_HOME=.cache/huggingface

# Logging verbosity: DEBUG / INFO / WARNING / ERROR
DEPTHWIZARD_LOG_LEVEL=INFO
